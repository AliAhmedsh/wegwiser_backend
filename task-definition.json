{
  "family": "wegwiserserver",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::728643659235:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::728643659235:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "wegwiserserver",
      "image": "728643659235.dkr.ecr.us-east-1.amazonaws.com/wegwiserserver:latest",
      "portMappings": [
        {
          "containerPort": 3001,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3001"
        }
      ],
      "secrets": [
        {
          "name": "AUTH0_DOMAIN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:728643659235:secret:wegwiser/auth0-domain"
        },
        {
          "name": "AUTH0_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:728643659235:secret:wegwiser/auth0-client-id"
        },
        {
          "name": "AUTH0_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:728643659235:secret:wegwiser/auth0-client-secret"
        },
        {
          "name": "AUTH0_AUDIENCE",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:728643659235:secret:wegwiser/auth0-audience"
        },
        {
          "name": "FASTAPI_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:728643659235:secret:wegwiser/fastapi-url"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/wegwiserserver",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:3001/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
} 